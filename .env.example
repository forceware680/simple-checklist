# Salin file ini menjadi .env lalu isi dengan kredensial Postgres kamu.
# Format: postgres://USER:PASSWORD@HOST:PORT/NAMA_DB
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/NAMA_DB
PORT=3000

# --- Admin (rekonsiliasi SIMASET) — ganti nilainya ---
# Username & password untuk login di halaman tersembunyi #/admin
ADMIN_USER=admin
ADMIN_PASS=ganti-dengan-password-kuat
# Kunci untuk menandatangani token sesi admin (acak, minimal 32 karakter)
ADMIN_SECRET=ganti-dengan-string-acak-min-32-karakter
